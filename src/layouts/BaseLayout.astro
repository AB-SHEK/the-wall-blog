---
import '../styles/global.css';
import WallNav from '../components/layout/WallNav.astro';
import SearchModal from '../components/layout/SearchModal.astro';
import { siteConfig } from '../config/site.config';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogImage = '/images/og-default.svg',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO & OpenGraph -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- RSS & Sitemap -->
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name} href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/rss.xml`} />

    <!-- Astro View Transitions -->
    <ClientRouter />

    <!-- Theme Preference Initialization -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bouldering-wall-bg text-stone-900 dark:text-stone-100 flex flex-col md:flex-row min-h-screen">
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 bg-amber-500 text-stone-900 font-bold px-4 py-2 rounded-lg">
      Skip to content
    </a>

    <!-- The Wall Climbing Navigation Sidebar -->
    <WallNav currentPath={currentPath} />

    <!-- The Wall Canvas / Content Stage -->
    <div class="flex-1 flex flex-col min-h-screen overflow-x-hidden relative">
      <main id="main-content" class="flex-1 max-w-5xl w-full mx-auto p-6 md:p-12" data-pagefind-body>
        <slot />
      </main>

      <!-- Crag Footer -->
      <footer class="p-6 md:p-8 border-t border-stone-200/80 dark:border-stone-800/80 text-xs text-stone-500 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span>© {new Date().getFullYear()} {siteConfig.author}. Climbed with passion.</span>
        </div>
        <div class="flex items-center gap-4">
          <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/rss.xml`} class="hover:text-amber-500 transition-colors">RSS Feed</a>
          <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logbook`} class="hover:text-amber-500 transition-colors">Route Logbook</a>
          <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer" class="hover:text-amber-500 transition-colors">GitHub</a>
        </div>
      </footer>
    </div>

    <!-- Search Palette -->
    <SearchModal />

    <!-- Directional Climbing Animation Controller -->
    <script>
      function applyClimbingTransition() {
        const direction = sessionStorage.getItem('wall-climb-direction') || 'up';
        const main = document.getElementById('main-content');
        if (!main) return;

        main.classList.remove('animate-climb-up', 'animate-down-climb', 'animate-traverse');
        if (direction === 'up') {
          main.classList.add('animate-climb-up');
        } else if (direction === 'down') {
          main.classList.add('animate-down-climb');
        } else {
          main.classList.add('animate-traverse');
        }
      }

      document.addEventListener('astro:page-load', applyClimbingTransition);
    </script>
  </body>
</html>
