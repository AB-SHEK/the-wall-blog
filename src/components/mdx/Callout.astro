---
interface Props {
  type?: 'beta' | 'warning' | 'crux' | 'note';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const styles: Record<string, { bg: string; border: string; icon: string; defaultTitle: string }> = {
  beta: {
    bg: 'bg-emerald-500/10 dark:bg-emerald-500/15',
    border: 'border-emerald-500/30 dark:border-emerald-500/40',
    icon: '💡',
    defaultTitle: 'Route Beta',
  },
  crux: {
    bg: 'bg-amber-500/10 dark:bg-amber-500/15',
    border: 'border-amber-500/30 dark:border-amber-500/40',
    icon: '⚡',
    defaultTitle: 'The Crux Move',
  },
  warning: {
    bg: 'bg-rose-500/10 dark:bg-rose-500/15',
    border: 'border-rose-500/30 dark:border-rose-500/40',
    icon: '⚠️',
    defaultTitle: 'Safety Warning',
  },
  note: {
    bg: 'bg-blue-500/10 dark:bg-blue-500/15',
    border: 'border-blue-500/30 dark:border-blue-500/40',
    icon: '📌',
    defaultTitle: 'Field Note',
  },
};

const current = styles[type] || styles.note;
---

<div class={`my-6 p-5 rounded-2xl border ${current.bg} ${current.border} relative overflow-hidden not-prose`}>
  <div class="flex items-center gap-2 mb-2 font-bold text-stone-900 dark:text-stone-100 text-sm">
    <span class="text-base">{current.icon}</span>
    <span>{title || current.defaultTitle}</span>
  </div>
  <div class="text-stone-700 dark:text-stone-300 text-sm leading-relaxed">
    <slot />
  </div>
</div>
