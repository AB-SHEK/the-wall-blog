---
interface Props {
  title: string;
  author: string;
  rating?: number; // 1 to 5
  cover?: string;
  thoughts?: string;
}

const { title, author, rating = 5, cover, thoughts } = Astro.props;
---

<div class="my-8 p-6 rounded-3xl bg-stone-100/80 dark:bg-stone-900/80 border border-stone-200 dark:border-stone-800 shadow-sm not-prose flex flex-col md:flex-row gap-6 items-start">
  {cover && (
    <img src={cover} alt={title} class="w-28 h-40 object-cover rounded-xl shadow-md border border-stone-300 dark:border-stone-700 flex-shrink-0" />
  )}
  <div class="flex-1">
    <div class="flex items-center gap-1 text-amber-500 mb-1">
      {Array.from({ length: rating }).map(() => (
        <span>★</span>
      ))}
      <span class="text-xs font-mono text-stone-500 ml-2">{rating}/5 stars</span>
    </div>
    <h3 class="text-xl font-bold text-stone-900 dark:text-stone-100">{title}</h3>
    <p class="text-xs font-mono text-stone-500 dark:text-stone-400 mb-3">by {author}</p>
    
    {thoughts && (
      <p class="text-sm text-stone-700 dark:text-stone-300 leading-relaxed italic bg-white/50 dark:bg-stone-800/50 p-3 rounded-xl border border-stone-200/50 dark:border-stone-700/50">
        "{thoughts}"
      </p>
    )}
    <div class="mt-3 text-sm text-stone-700 dark:text-stone-300">
      <slot />
    </div>
  </div>
</div>
